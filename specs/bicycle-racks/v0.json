            "description": "Bicycle racks statistics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "number"
                    },
                    "covered": {
                      "type": "number"
                    },
                    "public_access": {
                      "type": "number"
                    },
                    "avg_capacity": {
                      "type": "number"
                    },
                    "by_operator": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "number"
                      }
                    }
                  },
                  "required": [
                    "total",
                    "covered",
                    "public_access",
                    "avg_capacity",
                    "by_operator"
                  ]
                }
              }
            }
          }
        }
      }
