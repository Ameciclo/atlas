                          "minimum": -2147483648,
                          "maximum": 2147483647
                        },
                        "street_name": {
                          "type": "string",
                          "maxLength": 255
                        },
                        "neighborhood": {
                          "type": "string",
                          "maxLength": 100
                        },
                        "coordinates": {
                          "type": "string",
                          "nullable": true
                        },
                        "crash_data": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "number"
                            },
                            {
                              "type": "boolean"
                            },
                            {
                              "nullable": true
                            },
                            {
                              "type": "object",
                              "additionalProperties": {
                                "nullable": true
                              }
                            },
                            {
                              "type": "array",
                              "items": {
                                "nullable": true
                              }
                            },
                            {
                              "nullable": true
                            }
                          ]
                        },
                        "environmental_data": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "number"
                            },
                            {
                              "type": "boolean"
                            },
                            {
                              "nullable": true
                            },
                            {
                              "type": "object",
                              "additionalProperties": {
                                "nullable": true
                              }
                            },
                            {
                              "type": "array",
                              "items": {
                                "nullable": true
                              }
                            },
                            {
                              "nullable": true
                            }
                          ]
                        },
                        "metadata": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "number"
                            },
                            {
                              "type": "boolean"
                            },
                            {
                              "nullable": true
                            },
                            {
                              "type": "object",
                              "additionalProperties": {
                                "nullable": true
                              }
                            },
                            {
                              "type": "array",
                              "items": {
                                "nullable": true
                              }
                            },
                            {
                              "nullable": true
                            }
                          ]
                        },
                        "created_at": {
                          "type": "string"
                        },
                        "updated_at": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "datetime",
                        "nature",
                        "total_victims",
                        "injured_victims",
                        "fatal_victims",
                        "street_name",
                        "neighborhood",
                        "coordinates",
                        "crash_data",
                        "environmental_data",
                        "metadata",
                        "created_at",
                        "updated_at"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Traffic call not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "message"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "message"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}