          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Traffic call ID",
              "example": "1"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Traffic call details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "nullable": true,
                      "properties": {
                        "id": {
                          "type": "integer",
                          "minimum": -2147483648,
                          "maximum": 2147483647
                        },
                        "datetime": {
                          "type": "string"
                        },
                        "nature": {
                          "type": "string",
                          "maxLength": 50
                        },
                        "total_victims": {
                          "type": "integer",
