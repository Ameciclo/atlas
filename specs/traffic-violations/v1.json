    "/v1/violations": {
      "get": {
        "tags": [
          "Traffic Violations"
        ],
        "summary": "List traffic violations",
        "description": "Retrieve a list of traffic violations with optional filters",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "date",
              "description": "Filter violations from this date (YYYY-MM-DD)",
              "example": "2023-01-01"
            },
            "required": false,
            "name": "start_date",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "date",
              "description": "Filter violations until this date (YYYY-MM-DD)",
              "example": "2023-12-31"
            },
            "required": false,
            "name": "end_date",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 0,
              "exclusiveMinimum": true,
              "description": "Filter by agent ID",
              "example": 1
            },
            "required": false,
            "name": "agent_id",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 0,
              "exclusiveMinimum": true,
              "description": "Filter by violation type ID",
              "example": 5
            },
            "required": false,
            "name": "violation_type_id",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 0,
              "exclusiveMinimum": true,
              "description": "Filter by location ID",
              "example": 10
            },
            "required": false,
            "name": "location_id",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10,
              "description": "Number of records to return (1-100)",
              "example": 10
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "nullable": true,
              "minimum": 0,
              "default": 0,
              "description": "Number of records to skip",
              "example": 0
            },
            "required": false,
            "name": "offset",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "List of traffic violations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer",
                        "minimum": -2147483648,
                        "maximum": 2147483647
                      },
                      "violation_date": {
                        "type": "string"
                      },
                      "agent_id": {
                        "type": "integer",
                        "minimum": -2147483648,
                        "maximum": 2147483647
                      },
                      "violation_type_id": {
                        "type": "integer",
                        "minimum": -2147483648,
                        "maximum": 2147483647
                      },
                      "location_id": {
                        "type": "integer",
                        "minimum": -2147483648,
                        "maximum": 2147483647
                      },
                      "violation_code": {
                        "type": "string"
                      },
                      "law_code": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "location_description": {
                        "type": "string"
                      },
                      "coordinates": {
                        "type": "string",
                        "nullable": true
                      },
                      "street_code": {
                        "type": "integer",
                        "nullable": true,
                        "minimum": -2147483648,
                        "maximum": 2147483647
                      },
                      "complementary_data": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          },
                          {
                            "nullable": true
                          },
                          {
                            "type": "object",
                            "additionalProperties": {
                              "nullable": true
                            }
                          },
                          {
                            "type": "array",
                            "items": {
                              "nullable": true
                            }
                          },
                          {
                            "nullable": true
                          }
                        ]
                      },
                      "created_at": {
                        "type": "string"
                      },
                      "updated_at": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "violation_date",
                      "agent_id",
                      "violation_type_id",
                      "location_id",
                      "violation_code",
                      "law_code",
                      "description",
                      "location_description",
                      "coordinates",
                      "street_code",
                      "complementary_data",
                      "created_at",
                      "updated_at"
                    ],
                    "description": "Traffic violation data"
                  },
                  "description": "List of traffic violations"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
