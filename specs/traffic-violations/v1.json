                    "violation_date",
                    "agent_id",
                    "violation_type_id",
                    "location_id",
                    "violation_code",
                    "law_code",
                    "description",
                    "location_description",
                    "coordinates",
                    "street_code",
                    "complementary_data",
                    "created_at",
                    "updated_at"
                  ],
                  "description": "Traffic violation data"
                }
              }
            }
          },
          "404": {
            "description": "Traffic violation not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/streets": {
      "get": {
        "tags": [
          "Streets"
        ],
        "summary": "List official streets",
        "description": "Get a paginated list of official streets with optional filtering",
        "parameters": [
          {
            "schema": {
              "type": "number",
              "minimum": 1,
              "default": 1,
              "description": "Page number",
              "example": 1
            },
            "required": false,
            "name": "page",
            "in": "query"
          },
          {
            "schema": {
              "type": "number",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "description": "Number of items per page",
              "example": 20
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Search in street names",
              "example": "rua"
            },
            "required": false,
            "name": "search",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Filter by neighborhood name",
              "example": "BOA VIAGEM"
            },
            "required": false,
            "name": "neighborhood",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "List of streets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "number"
                          },
                          "code": {
                            "type": "number"
                          },
                          "name_concatenated": {
                            "type": "string"
                          },
                          "official_name": {
                            "type": "string"
                          },
                          "short_name": {
                            "type": "string"
                          },
                          "pavement_code": {
                            "type": "string",
                            "nullable": true
                          },
                          "pavement_description": {
                            "type": "string",
                            "nullable": true
                          },
                          "transport_corridor": {
                            "type": "boolean",
                            "nullable": true
                          },
                          "perimeter_road": {
                            "type": "boolean",
                            "nullable": true
                          },
                          "neighborhood_code": {
                            "type": "number",
                            "nullable": true
                          },
                          "neighborhood_name": {
                            "type": "string",
                            "nullable": true
                          }
                        },
                        "required": [
                          "id",
                          "code",
                          "name_concatenated",
                          "official_name",
                          "short_name",
                          "pavement_code",
                          "pavement_description",
                          "transport_corridor",
                          "perimeter_road",
                          "neighborhood_code",
                          "neighborhood_name"
                        ]
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "page": {
                          "type": "number"
                        },
                        "limit": {
                          "type": "number"
                        },
                        "total": {
                          "type": "number"
                        },
                        "totalPages": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "page",
                        "limit",
                        "total",
                        "totalPages"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "pagination"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
