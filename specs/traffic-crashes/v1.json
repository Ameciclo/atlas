{
  "openapi": "3.1.0",
  "info": {
    "title": "TrafficCrashes API",
    "version": "1.0.0",
    "description": "API service for traffic_crashes",
    "contact": {
      "name": "Atlas Team",
      "url": "https://github.com/Ameciclo/atlas"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3007",
      "description": "Local development server"
    },
    {
      "url": "https://api.atlas.example.com",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Example",
      "description": "Example endpoints"
    },
    {
      "name": "System",
      "description": "System endpoints (health check, etc.)"
    }
  ],
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "error"
                      ]
                    },
                    "timestamp": {
                      "type": "string"
                    },
                    "service": {
                      "type": "string"
                    },
                    "database": {
                      "type": "string",
                      "enum": [
                        "connected",
                        "disconnected"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "timestamp",
                    "service",
                    "database"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Service is unhealthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "error"
                      ]
                    },
                    "timestamp": {
                      "type": "string"
                    },
                    "service": {
                      "type": "string"
                    },
                    "database": {
                      "type": "string",
                      "enum": [
                        "connected",
                        "disconnected"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "timestamp",
                    "service",
                    "database"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/crashes": {
      "get": {
        "tags": [
          "Crashes"
        ],
        "summary": "List all geolocated crashes",
        "description": "Get all traffic crashes with geographic coordinates, optionally filtered by date range",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Filter crashes from this date (YYYY-MM-DD)",
              "example": "2023-01-01"
            },
            "required": false,
            "name": "start_date",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Filter crashes until this date (YYYY-MM-DD)",
              "example": "2023-12-31"
            },
            "required": false,
            "name": "end_date",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "List of geolocated crashes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer",
                        "minimum": -2147483648,
                        "maximum": 2147483647
                      },
                      "timestamp": {
                        "type": "string"
                      },
                      "n_injured": {
                        "type": "integer",
                        "minimum": -2147483648,
                        "maximum": 2147483647
                      },
                      "n_deaths": {
                        "type": "integer",
                        "minimum": -2147483648,
                        "maximum": 2147483647
                      },
                      "coordinates": {
                        "type": "string"
                      },
                      "complementary_data": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          },
                          {
                            "nullable": true
                          },
                          {
                            "type": "object",
                            "additionalProperties": {
                              "nullable": true
                            }
                          },
                          {
                            "type": "array",
                            "items": {
                              "nullable": true
                            }
                          },
                          {
                            "nullable": true
                          }
                        ]
                      },
                      "created_at": {
                        "type": "string"
                      },
                      "updated_at": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "timestamp",
                      "n_injured",
                      "n_deaths",
                      "coordinates",
                      "complementary_data",
                      "created_at",
                      "updated_at"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/crashes/{id}": {
      "get": {
        "tags": [
          "Crashes"
        ],
        "summary": "Get crash by ID",
        "description": "Get a specific traffic crash by its ID",
        "parameters": [
          {
            "schema": {
              "type": "number",
              "nullable": true,
              "required": [
                "id"
              ],
              "example": 42
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Traffic crash details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "minimum": -2147483648,
                      "maximum": 2147483647
                    },
                    "timestamp": {
                      "type": "string"
                    },
                    "n_injured": {
                      "type": "integer",
                      "minimum": -2147483648,
                      "maximum": 2147483647
                    },
                    "n_deaths": {
                      "type": "integer",
                      "minimum": -2147483648,
                      "maximum": 2147483647
                    },
                    "coordinates": {
                      "type": "string"
                    },
                    "complementary_data": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "nullable": true
                        },
                        {
                          "type": "object",
                          "additionalProperties": {
                            "nullable": true
                          }
                        },
                        {
                          "type": "array",
                          "items": {
                            "nullable": true
                          }
                        },
                        {
                          "nullable": true
                        }
                      ]
                    },
                    "created_at": {
                      "type": "string"
                    },
                    "updated_at": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "timestamp",
                    "n_injured",
                    "n_deaths",
                    "coordinates",
                    "complementary_data",
                    "created_at",
                    "updated_at"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Crash not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ],
                  "example": {
                    "message": "Not Found"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}