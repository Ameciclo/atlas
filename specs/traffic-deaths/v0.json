                        }
                      },
                      "required": [
                        "porAno",
                        "porSexo",
                        "porRacaCor",
                        "porFaixaEtaria",
                        "porMunicipio",
                        "porModoTransporte",
                        "porLocalOcorrenciaObito"
                      ]
                    },
                    "dados": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ano": {
                            "type": "number"
                          },
                          "municipio": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "number"
                              },
                              "nome": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "id",
                              "nome"
                            ]
                          },
                          "sexo": {
                            "type": "object",
                            "properties": {
                              "codigo": {
                                "type": "string"
                              },
                              "descricao": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "codigo",
                              "descricao"
                            ]
                          },
                          "racacor": {
                            "type": "object",
                            "properties": {
                              "codigo": {
                                "type": "string"
                              },
                              "descricao": {
                                "type": "string"
                              }
                            },
                            "required": [
