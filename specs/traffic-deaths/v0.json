{
  "openapi": "3.1.0",
  "info": {
    "title": "Traffic Deaths API",
    "version": "0.1.0",
    "description": "API service for managing traffic deaths data from DATASUS (Brazil's public health data system)",
    "contact": {
      "name": "Atlas Team",
      "url": "https://github.com/Ameciclo/atlas"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3003",
      "description": "Local development server"
    },
    {
      "url": "https://api.ameciclo.org/traffic-deaths",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Summary",
      "description": "Traffic deaths summary statistics"
    },
    {
      "name": "Cyclists",
      "description": "Cyclist-specific traffic deaths (CID-10 codes V10-V19)"
    },
    {
      "name": "System",
      "description": "System operations"
    }
  ],
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "error"
                      ]
                    },
                    "timestamp": {
                      "type": "string"
                    },
                    "service": {
                      "type": "string"
                    },
                    "database": {
                      "type": "string",
                      "enum": [
                        "connected",
                        "disconnected"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "timestamp",
                    "service",
                    "database"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Service is unhealthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "error"
                      ]
                    },
                    "timestamp": {
                      "type": "string"
                    },
                    "service": {
                      "type": "string"
                    },
                    "database": {
                      "type": "string",
                      "enum": [
                        "connected",
                        "disconnected"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "timestamp",
                    "service",
                    "database"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/summary": {
      "get": {
        "tags": [
          "Summary"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 2015,
              "maximum": 2030
            },
            "required": false,
            "name": "year",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Traffic deaths summary statistics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total_deaths": {
                      "type": "number"
                    },
                    "year": {
                      "type": "number",
                      "nullable": true
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "total_deaths",
                    "year",
                    "message"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/deaths/cyclists": {
      "get": {
        "tags": [
          "Cyclists"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 2015,
              "maximum": 2030
            },
            "required": false,
            "name": "year",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "nullable": true
            },
            "required": false,
            "name": "city_code",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Cyclist deaths statistics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total_cyclist_deaths": {
                      "type": "number"
                    },
                    "year": {
                      "type": "number",
                      "nullable": true
                    },
                    "city_code": {
                      "type": "number",
                      "nullable": true
                    },
                    "percentage_of_total": {
                      "type": "number"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "total_cyclist_deaths",
                    "year",
                    "city_code",
                    "percentage_of_total",
                    "message"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}