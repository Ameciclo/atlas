{
  "openapi": "3.1.0",
  "info": {
    "title": "Traffic Deaths API",
    "version": "0.1.0",
    "description": "API service for managing traffic deaths data from DATASUS (Brazil's public health data system)",
    "contact": {
      "name": "Atlas Team",
      "url": "https://github.com/Ameciclo/atlas"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3003",
      "description": "Local development server"
    },
    {
      "url": "https://api.ameciclo.org/traffic-deaths",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Summary",
      "description": "Traffic deaths summary statistics"
    },
    {
      "name": "Cyclists",
      "description": "Cyclist-specific traffic deaths (CID-10 codes V10-V19)"
    },
    {
      "name": "System",
      "description": "System operations"
    }
  ],
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "error"
                      ]
                    },
                    "timestamp": {
                      "type": "string"
                    },
                    "service": {
                      "type": "string"
                    },
                    "database": {
                      "type": "string",
                      "enum": [
                        "connected",
                        "disconnected"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "timestamp",
                    "service",
                    "database"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Service is unhealthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "error"
                      ]
                    },
                    "timestamp": {
                      "type": "string"
                    },
                    "service": {
                      "type": "string"
                    },
                    "database": {
                      "type": "string",
                      "enum": [
                        "connected",
                        "disconnected"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "timestamp",
                    "service",
                    "database"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/summary": {
      "get": {
        "tags": [
          "V1 Summary"
        ],
        "responses": {
          "200": {
            "description": "Resumo estatístico das mortes no trânsito na RMR",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "porLocalOcorrencia": {
                      "type": "object",
                      "properties": {
                        "totalSinistrosUltimos10Anos": {
                          "type": "number"
                        },
                        "totalUltimoAno": {
                          "type": "number"
                        },
                        "ultimoAno": {
                          "type": "number"
                        },
                        "crescimentoRelacaoAnoAnterior": {
                          "type": "number"
                        },
                        "anoMaisViolento": {
                          "type": "object",
                          "properties": {
                            "ano": {
                              "type": "number"
                            },
                            "total": {
                              "type": "number"
                            }
                          },
                          "required": [
                            "ano",
                            "total"
                          ]
                        },
                        "dadosPorAno": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "ano": {
                                "type": "number"
                              },
                              "total": {
                                "type": "number"
                              }
                            },
                            "required": [
                              "ano",
                              "total"
                            ]
                          }
                        }
                      },
                      "required": [
                        "totalSinistrosUltimos10Anos",
                        "totalUltimoAno",
                        "ultimoAno",
                        "crescimentoRelacaoAnoAnterior",
                        "anoMaisViolento",
                        "dadosPorAno"
                      ]
                    },
                    "porLocalResidencia": {
                      "type": "object",
                      "properties": {
                        "totalSinistrosUltimos10Anos": {
                          "type": "number"
                        },
                        "totalUltimoAno": {
                          "type": "number"
                        },
                        "ultimoAno": {
                          "type": "number"
                        },
                        "crescimentoRelacaoAnoAnterior": {
                          "type": "number"
                        },
                        "anoMaisViolento": {
                          "type": "object",
                          "properties": {
                            "ano": {
                              "type": "number"
                            },
                            "total": {
                              "type": "number"
                            }
                          },
                          "required": [
                            "ano",
                            "total"
                          ]
                        },
                        "dadosPorAno": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "ano": {
                                "type": "number"
                              },
                              "total": {
                                "type": "number"
                              }
                            },
                            "required": [
                              "ano",
                              "total"
                            ]
                          }
                        }
                      },
                      "required": [
                        "totalSinistrosUltimos10Anos",
                        "totalUltimoAno",
                        "ultimoAno",
                        "crescimentoRelacaoAnoAnterior",
                        "anoMaisViolento",
                        "dadosPorAno"
                      ]
                    }
                  },
                  "required": [
                    "porLocalOcorrencia",
                    "porLocalResidencia"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/cities-by-year": {
      "get": {
        "tags": [
          "V1 Cities"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "ocorrencia",
                "residencia"
              ],
              "default": "ocorrencia"
            },
            "required": false,
            "name": "tipoLocal",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Dados de mortes por cidade da RMR divididos por ano",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tipo": {
                      "type": "string"
                    },
                    "anos": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    },
                    "cidades": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "number"
                          },
                          "nome": {
                            "type": "string"
                          },
                          "total": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "id",
                          "nome",
                          "total"
                        ],
                        "additionalProperties": {
                          "anyOf": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "string"
                            }
                          ]
                        }
                      }
                    }
                  },
                  "required": [
                    "tipo",
                    "anos",
                    "cidades"
                  ]
                }
              }
            }
          }
        }
      }
    },
