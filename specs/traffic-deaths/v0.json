                              "descricao"
                            ]
                          },
                          "idade": {
                            "type": "number"
                          },
                          "idadeOriginal": {
                            "type": "number"
                          },
                          "faixaEtaria": {
                            "type": "string"
                          },
                          "modoTransporte": {
                            "type": "object",
                            "properties": {
                              "codigo": {
                                "type": "string"
                              },
                              "descricao": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "codigo",
                              "descricao"
                            ]
                          },
                          "localOcorrenciaObito": {
                            "type": "object",
                            "properties": {
                              "codigo": {
                                "type": "string"
                              },
                              "descricao": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "codigo",
                              "descricao"
                            ]
                          },
                          "causabas": {
                            "type": "string"
                          },
                          "total": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "ano",
                          "municipio",
                          "sexo",
                          "racacor",
                          "idade",
                          "idadeOriginal",
                          "faixaEtaria",
                          "modoTransporte",
                          "localOcorrenciaObito",
                          "causabas",
                          "total"
                        ]
                      }
                    }
                  },
                  "required": [
                    "filtrosAplicados",
                    "totalGeral",
                    "resumo",
                    "dados"
                  ]
                }
              }
