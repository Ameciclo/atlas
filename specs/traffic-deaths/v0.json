{
  "openapi": "3.1.0",
  "info": {
    "title": "Traffic Deaths API",
    "version": "0.1.0",
    "description": "API service for managing traffic deaths data from DATASUS (Brazil's public health data system)",
    "contact": {
      "name": "Atlas Team",
      "url": "https://github.com/Ameciclo/atlas"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3003",
      "description": "Local development server"
    },
    {
      "url": "https://api.ameciclo.org/traffic-deaths",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Summary",
      "description": "Traffic deaths summary statistics"
    },
    {
      "name": "Cyclists",
      "description": "Cyclist-specific traffic deaths (CID-10 codes V10-V19)"
    },
    {
      "name": "System",
      "description": "System operations"
    }
  ],
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "error"
                      ]
                    },
                    "timestamp": {
                      "type": "string"
                    },
                    "service": {
                      "type": "string"
                    },
                    "database": {
                      "type": "string",
                      "enum": [
                        "connected",
                        "disconnected"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "timestamp",
                    "service",
                    "database"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Service is unhealthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "error"
                      ]
                    },
                    "timestamp": {
                      "type": "string"
                    },
                    "service": {
                      "type": "string"
                    },
                    "database": {
                      "type": "string",
                      "enum": [
                        "connected",
                        "disconnected"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "timestamp",
                    "service",
                    "database"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/summary": {
      "get": {
        "tags": [
          "Summary"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 2015,
              "maximum": 2030
            },
            "required": false,
            "name": "year",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Traffic deaths summary statistics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total_deaths": {
                      "type": "number"
                    },
                    "year": {
                      "type": "number",
                      "nullable": true
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "total_deaths",
                    "year",
                    "message"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/deaths/cyclists": {
      "get": {
        "tags": [
          "Cyclists"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 2015,
              "maximum": 2030
            },
            "required": false,
            "name": "year",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "nullable": true
            },
            "required": false,
            "name": "city_code",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Cyclist deaths statistics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total_cyclist_deaths": {
                      "type": "number"
                    },
                    "year": {
                      "type": "number",
                      "nullable": true
                    },
                    "city_code": {
                      "type": "number",
                      "nullable": true
                    },
                    "percentage_of_total": {
                      "type": "number"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "total_cyclist_deaths",
                    "year",
                    "city_code",
                    "percentage_of_total",
                    "message"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/deaths/by-city": {
      "get": {
        "tags": [
          "Geographic Analysis"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 2015,
              "maximum": 2030
            },
            "required": false,
            "name": "year",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "occurrence",
                "residence"
              ],
              "default": "occurrence"
            },
            "required": false,
            "name": "location_type",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Deaths grouped by city",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "location_type": {
                      "type": "string",
                      "enum": [
                        "occurrence",
                        "residence"
                      ]
                    },
                    "year": {
                      "type": "number",
                      "nullable": true
                    },
                    "cities": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "city_code": {
                            "type": "number"
                          },
                          "city_name": {
                            "type": "string",
                            "nullable": true
                          },
                          "total_deaths": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "city_code",
                          "city_name",
                          "total_deaths"
                        ]
                      }
                    },
                    "total": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "location_type",
                    "year",
                    "cities",
                    "total"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/deaths/by-transport-mode": {
      "get": {
        "tags": [
          "Transport Mode Analysis"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 2015,
              "maximum": 2030
            },
            "required": false,
            "name": "year",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "nullable": true
            },
            "required": false,
            "name": "city_code",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "occurrence",
                "residence"
              ],
              "default": "occurrence"
            },
            "required": false,
            "name": "location_type",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Deaths grouped by transport mode",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "year": {
                      "type": "number",
                      "nullable": true
                    },
                    "city_code": {
                      "type": "number",
                      "nullable": true
                    },
                    "location_type": {
                      "type": "string",
                      "enum": [
                        "occurrence",
                        "residence"
                      ]
                    },
                    "transport_modes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "mode": {
                            "type": "string"
                          },
                          "cid10_codes": {
                            "type": "string"
                          },
                          "total_deaths": {
                            "type": "number"
                          },
                          "percentage": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "mode",
                          "cid10_codes",
                          "total_deaths",
                          "percentage"
                        ]
                      }
                    },
                    "total": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "year",
                    "city_code",
                    "location_type",
                    "transport_modes",
                    "total"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/deaths/time-series": {
      "get": {
        "tags": [
          "Time Series Analysis"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 2015,
              "maximum": 2030
            },
            "required": false,
            "name": "start_year",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 2015,
              "maximum": 2030
            },
            "required": false,
            "name": "end_year",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "nullable": true
            },
            "required": false,
            "name": "city_code",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "pedestrian",
                "cyclist",
                "motorcyclist",
                "tricycle",
                "car",
                "pickup",
                "heavy_vehicle",
                "bus",
                "other",
                "unspecified"
              ]
            },
            "required": false,
            "name": "transport_mode",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "occurrence",
                "residence"
              ],
              "default": "occurrence"
            },
            "required": false,
            "name": "location_type",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Time series of deaths by year",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "start_year": {
                      "type": "number"
                    },
                    "end_year": {
                      "type": "number"
                    },
                    "city_code": {
                      "type": "number",
                      "nullable": true
                    },
                    "transport_mode": {
                      "type": "string",
                      "nullable": true
                    },
                    "location_type": {
                      "type": "string",
                      "enum": [
                        "occurrence",
                        "residence"
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "year": {
                            "type": "number"
                          },
                          "total_deaths": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "year",
                          "total_deaths"
                        ]
                      }
                    },
                    "total": {
                      "type": "number"
                    },
                    "average_per_year": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "start_year",
                    "end_year",
                    "city_code",
                    "transport_mode",
                    "location_type",
                    "data",
                    "total",
                    "average_per_year"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/stats": {
      "get": {
        "tags": [
          "Statistics"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "nullable": true
            },
            "required": false,
            "name": "city_code",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "occurrence",
                "residence"
              ],
              "default": "occurrence"
            },
            "required": false,
            "name": "location_type",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Comprehensive statistics summary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "city_code": {
                      "type": "number",
                      "nullable": true
                    },
                    "location_type": {
                      "type": "string",
                      "enum": [
                        "occurrence",
                        "residence"
                      ]
                    },
                    "latest_year": {
                      "type": "number"
                    },
                    "latest_year_deaths": {
                      "type": "number"
                    },
                    "previous_year_deaths": {
                      "type": "number"
                    },
                    "growth_percentage": {
                      "type": "number"
                    },
                    "most_violent_year": {
                      "type": "object",
                      "properties": {
                        "year": {
                          "type": "number"
                        },
                        "total_deaths": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "year",
                        "total_deaths"
                      ]
                    },
                    "last_5_years": {
                      "type": "object",
                      "properties": {
                        "total_deaths": {
                          "type": "number"
                        },
                        "average_per_year": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "total_deaths",
                        "average_per_year"
                      ]
                    },
                    "all_time": {
                      "type": "object",
                      "properties": {
                        "total_deaths": {
                          "type": "number"
                        },
                        "years_covered": {
                          "type": "number"
                        },
                        "average_per_year": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "total_deaths",
                        "years_covered",
                        "average_per_year"
                      ]
                    }
                  },
                  "required": [
                    "city_code",
                    "location_type",
                    "latest_year",
                    "latest_year_deaths",
                    "previous_year_deaths",
                    "growth_percentage",
                    "most_violent_year",
                    "last_5_years",
                    "all_time"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}