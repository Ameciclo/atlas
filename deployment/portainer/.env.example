# Atlas Portainer Environment Variables
# Copy this file to .env and fill in the values
# These variables are used by Portainer stacks

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# PostgreSQL port (default: 5432)
POSTGRES_PORT=5432

# PostgreSQL performance tuning
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_MAX_CONNECTIONS=100

# ============================================================================
# Cyclist Profile Service
# ============================================================================

# Image tag (latest, sha-abc1234, or specific version)
CYCLIST_PROFILE_TAG=latest

# Service port
CYCLIST_PROFILE_PORT=3000

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# ============================================================================
# Documentation Service
# ============================================================================

# Image tag
DOCS_TAG=latest

# Service port
DOCS_PORT=3001

# ============================================================================
# Optional: Custom Configuration
# ============================================================================

# API Keys (if needed)
# API_KEY=your-api-key-here

# CORS Configuration (if needed)
# CORS_ORIGIN=https://yourdomain.com

# Custom API base URL for docs
# API_BASE_URL=https://api.yourdomain.com

