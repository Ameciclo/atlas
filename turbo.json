{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"remoteCache": {
		"signature": true
	},
	"tasks": {
		"build": {
			"dependsOn": ["^build", "generate-openapi"],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*",
				"docker-compose.yml",
				"Dockerfile"
			],
			"outputs": ["dist/**"]
		},
		"generate-openapi": {
			"dependsOn": ["^build"],
			"cache": false,
			"outputs": []
		},
		"check-types": {
			"dependsOn": ["^build"]
		},
		"pre-dev": {
			"cache": false,
			"outputs": []
		},
		"dev": {
			"dependsOn": ["pre-dev"],
			"cache": false,
			"persistent": true
		},
		"lint": {
			"dependsOn": ["^lint"],
			"inputs": ["src/**", "$TURBO_DEFAULT$"],
			"outputs": []
		},
		"format": {
			"cache": false,
			"inputs": ["src/**", "$TURBO_DEFAULT$"],
			"outputs": [],
			"persistent": true
		},
		"test": {
			"dependsOn": ["^build"],
			"cache": false,
			"inputs": ["src/**", "test/**", "$TURBO_DEFAULT$"],
			"persistent": true
		},
		"docker:build": {
			"dependsOn": ["build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"Dockerfile",
				"dist/**",
				".dockerignore"
			],
			"outputs": [],
			"cache": false
		},
		"release": {
			"dependsOn": ["build", "lint", "check-types"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"package.json",
				"CHANGELOG.md"
			],
			"outputs": [],
			"cache": false
		}
	}
}
