{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},
		"check-types": { "dependsOn": ["^check-types"] },
		"dev": {
			"cache": false,
			"persistent": true
		},
		"lint": { "dependsOn": ["^lint"], "inputs": ["src/**", "$TURBO_DEFAULT$"] },
		"format": { "cache": false, "persistent": true, "outputs": [] },
		"test": {
			"dependsOn": ["^test"],
			"cache": false,
			"inputs": ["src/**", "test/**", "$TURBO_DEFAULT$"],
			"persistent": true
		}
	}
}
