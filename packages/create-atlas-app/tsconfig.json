{
	"extends": "@atlas/typescript-config/base.json",
	"compilerOptions": {
		"lib": ["ES2022"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowJs": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"sourceMap": true,
		"types": ["node"]
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
