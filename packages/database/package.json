{
	"name": "@atlas/database",
	"version": "0.1.0",
	"description": "Shared database package for Atlas monorepo with Drizzle ORM",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./schemas/cyclist-profile": {
			"types": "./dist/schemas/cyclist-profile/index.d.ts",
			"import": "./dist/schemas/cyclist-profile/index.js"
		},
		"./schemas/cyclist-counts": {
			"types": "./dist/schemas/cyclist-counts/index.d.ts",
			"import": "./dist/schemas/cyclist-counts/index.js"
		},
		"./migrations/*": {
			"types": "./dist/migrations/*.d.ts",
			"import": "./dist/migrations/*.js"
		},
		"./schemas/traffic-deaths": {
			"types": "./dist/schemas/traffic-deaths/index.d.ts",
			"import": "./dist/schemas/traffic-deaths/index.js"
		},
		"./schemas/shared-bike": {
			"types": "./dist/schemas/shared-bike/index.d.ts",
			"import": "./dist/schemas/shared-bike/index.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"check-types": "tsc --noEmit",
		"lint": "biome lint .",
		"format": "biome format .",
		"db:studio": "drizzle-kit studio",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx src/migrate.ts",
		"db:seed": "tsx src/seed.ts",
		"db:seed-shared-bike": "tsx src/seed-shared-bike.ts",
		"db:reset": "tsx src/reset.ts",
		"db:drop": "drizzle-kit drop",
		"db:custom": "drizzle-kit generate --custom"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.922.0",
		"dotenv": "^16.5.0",
		"drizzle-orm": "^0.43.1",
		"drizzle-zod": "^0.7.1",
		"pg": "^8.14.1",
		"zod": "^3.24.4"
	},
	"devDependencies": {
		"@atlas/typescript-config": "workspace:*",
		"@types/node": "^22.15.17",
		"@types/pg": "^8.11.13",
		"csv-parse": "^6.1.0",
		"drizzle-kit": "^0.31.0",
		"tsx": "^4.19.3",
		"typescript": "^5.8.3"
	},
	"peerDependencies": {
		"typescript": "^5.8.3"
	}
}
