{
	"name": "@atlas/database",
	"version": "0.1.0",
	"description": "Shared database package for Atlas monorepo with Drizzle ORM",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./schemas/cyclist-profile": {
			"types": "./dist/schemas/cyclist-profile/index.d.ts",
			"import": "./dist/schemas/cyclist-profile/index.js"
		},
		"./schemas/cyclist-counts": {
			"types": "./dist/schemas/cyclist-counts/index.d.ts",
			"import": "./dist/schemas/cyclist-counts/index.js"
		},
		"./migrations/*": {
			"types": "./dist/migrations/*.d.ts",
			"import": "./dist/migrations/*.js"
		},
		"./schemas/bicycle-racks": {
			"types": "./dist/schemas/bicycle-racks/index.d.ts",
			"import": "./dist/schemas/bicycle-racks/index.js"
		},
		"./schemas/traffic-deaths": {
			"types": "./dist/schemas/traffic-deaths/index.d.ts",
			"import": "./dist/schemas/traffic-deaths/index.js"
		},
		"./schemas/traffic-calls": {
			"types": "./dist/schemas/traffic-calls/index.d.ts",
			"import": "./dist/schemas/traffic-calls/index.js"
		},
		"./schemas/emergency-calls": {
			"types": "./dist/schemas/emergency-calls/index.d.ts",
			"import": "./dist/schemas/emergency-calls/index.js"
		},
		"./schemas/emergency-calls/categories": {
			"types": "./dist/schemas/emergency-calls/categories.d.ts",
			"import": "./dist/schemas/emergency-calls/categories.js"
		},
		"./schemas/traffic-tickets": {
			"types": "./dist/schemas/traffic-tickets/index.d.ts",
			"import": "./dist/schemas/traffic-tickets/index.js"
		},
		"./schemas/test-db-service": {
			"types": "./dist/schemas/test-db-service/index.d.ts",
			"import": "./dist/schemas/test-db-service/index.js"
		},
		"./schemas/cycling-infra": {
			"types": "./dist/schemas/cycling-infra/index.d.ts",
			"import": "./dist/schemas/cycling-infra/index.js"
		},
		"./schemas/shared-bike": {
			"types": "./dist/schemas/shared-bike/index.d.ts",
			"import": "./dist/schemas/shared-bike/index.js"
		},
		"./schemas/pcr-streets": {
			"types": "./dist/schemas/pcr-streets/index.d.ts",
			"import": "./dist/schemas/pcr-streets/index.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"check-types": "tsc --noEmit",
		"lint": "biome lint .",
		"format": "biome format .",
		"db:studio": "drizzle-kit studio",
		"db:generate": "drizzle-kit generate",
		"db:generate:custom": "drizzle-kit generate --custom",
		"db:drop": "drizzle-kit drop",
		"db:custom": "drizzle-kit generate --custom",
		"db:migrate": "tsx src/migrate.ts",
		"db:seed:recompose": "bash scripts/recompose-data.sh",
		"db:seed": "bash scripts/recompose-data.sh && tsx src/seed.ts",
		"db:seed:cyclist-counts": "tsx src/seed-cyclist-counts.ts",
		"db:seed:cyclist-profiles": "tsx src/seed-cyclist-profiles.ts",
		"db:seed:bicycle-racks": "tsx src/seed-bicycle-racks.ts",
		"db:seed-traffic-calls": "tsx src/seed-traffic-calls.ts",
		"db:seed-cycling-infra": "tsx src/seed-cycling-infra.ts",
		"db:seed-cycling-infra-static": "tsx src/seed.ts --only=cycling-infra-static",
		"db:seed-static": "tsx src/seed.ts --only=cycling-infra-static",
		"db:seed-shared-bike": "tsx src/seed-shared-bike.ts",
		"db:seed:traffic-deaths": "tsx src/seed-traffic-deaths.ts",
		"db:seed:traffic-tickets": "tsx src/seed-traffic-tickets.ts",
		"db:reset": "tsx src/reset.ts",
		"db:refresh-mvs": "tsx src/refresh-traffic-tickets-mvs.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.922.0",
		"dotenv": "^16.5.0",
		"drizzle-orm": "^0.43.1",
		"drizzle-zod": "^0.7.1",
		"pg": "^8.14.1",
		"zod": "^3.24.4"
	},
	"devDependencies": {
		"@atlas/typescript-config": "workspace:*",
		"@types/node": "^22.15.17",
		"@types/pg": "^8.11.13",
		"csv-parse": "^6.1.0",
		"drizzle-kit": "^0.31.0",
		"drizzle-seed": "^0.3.1",
		"tsx": "^4.19.3",
		"typescript": "^5.8.3"
	},
	"peerDependencies": {
		"typescript": "^5.8.3"
	}
}
