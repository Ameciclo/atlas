# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/atlas_dev

# Seed Data Configuration
# Set to "true" to load seed data from S3 (DigitalOcean Spaces)
# Set to "false" or omit to load from local files
SEED_DATA_USE_S3=false

# DigitalOcean Spaces Configuration (required if SEED_DATA_USE_S3=true)
DO_SPACE_SECRET=your-digitalocean-space-secret-key
DO_ACCESS_KEY=your-digitalocean-access-key
DO_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACE_BUCKET=ameciclo-space
DO_SPACE_REGION=nyc3

# Seed Data Cache Configuration
# Cache TTL in milliseconds (default: 24 hours = 86400000)
SEED_DATA_CACHE_TTL=86400000

# CSV Directory (optional, for local file loading)
# Defaults to packages/database/seed-data/traffic-deaths
# CSV_DIR=/path/to/csv/files

