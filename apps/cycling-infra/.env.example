# Environment Configuration

# Node Environment
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Server
PORT=3020

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/atlas_dev

# Or use individual settings:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=atlas_dev

# SSL Configuration
# Path to SSL CA certificate for production databases (e.g., Digital Ocean)
# When set, SSL will be automatically enabled
# DATABASE_SSL_CA=/path/to/ca-certificate.crt

# API Limits
# Maximum number of ways returned in /v1/ways/all-ways endpoint
MAX_WAYS_RESULTS=1000

# Geometry Simplification
# Tolerance for ST_Simplify (smaller = more detail, larger = fewer points)
GEOMETRY_SIMPLIFY_TOLERANCE=0.0001

# GeoJSON Precision
# Decimal places for coordinates (4=~10m, 5=~1m, 6=~0.1m precision)
GEOJSON_PRECISION=5
