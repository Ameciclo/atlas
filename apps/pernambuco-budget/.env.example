# Environment Configuration

# Node Environment
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Server
PORT=3015

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pernambuco-budget_db

# Or use individual settings:
DB_HOST=localhost
