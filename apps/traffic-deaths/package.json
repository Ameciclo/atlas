{
	"name": "@atlas/traffic-deaths",
	"version": "0.1.0",
	"description": "API service for managing traffic deaths data from DATASUS",
	"type": "module",
	"main": "./dist/index.js",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc && pnpm generate-openapi",
		"start": "node dist/index.js",
		"lint": "biome lint .",
		"format": "biome format .",
		"check-types": "tsc --noEmit --project tsconfig.test.json",
		"test": "NODE_ENV=test vitest --run",
		"test:watch": "NODE_ENV=test vitest --watch",
		"generate-openapi": "tsx src/generate-openapi.ts",
		"pre-dev": "pnpm generate-openapi",
		"db:seed": "tsx src/db/seed.ts"
	},
	"dependencies": {
		"@atlas/database": "workspace:*",
		"@hono/node-server": "^1.14.1",
		"@hono/zod-openapi": "^0.19.6",
		"dotenv": "^16.5.0",
		"drizzle-orm": "^0.43.1",
		"hono": "^4.10.2",
		"hono-pino": "^0.8.0",
		"pg": "^8.14.1",
		"pino": "^9.6.0",
		"pino-pretty": "^13.0.0",
		"stoker": "^1.4.2",
		"zod": "^3.24.4"
	},
	"devDependencies": {
		"@atlas/typescript-config": "workspace:*",
		"@types/node": "^22.15.17",
		"@types/pg": "^8.11.13",
		"tsx": "^4.19.3",
		"typescript": "^5.8.3",
		"vitest": "^3.1.3"
	}
}
