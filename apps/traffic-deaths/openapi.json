			"get": {
				"tags": ["System"],
				"responses": {
					"200": {
						"description": "Service is healthy",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"status": {
											"type": "string",
											"enum": ["ok", "error"]
										},
										"timestamp": {
											"type": "string"
										},
										"service": {
											"type": "string"
										},
										"database": {
											"type": "string",
											"enum": ["connected", "disconnected"]
										}
									},
									"required": ["status", "timestamp", "service", "database"]
								}
							}
						}
					},
					"503": {
						"description": "Service is unhealthy",
						"content": {
							"application/json": {
								"schema": {
