# Environment Configuration

# Node Environment
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Server
PORT=3003

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/traffic-deaths_db

# Or use individual settings:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=traffic-deaths_db

# SSL Configuration
# Path to SSL CA certificate for production databases (e.g., Digital Ocean)
# When set, SSL will be automatically enabled
# DATABASE_SSL_CA=/path/to/ca-certificate.crt
