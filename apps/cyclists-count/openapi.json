                        {
                          "nullable": true
                        },
                        {
                          "type": "object",
                          "additionalProperties": {
                            "nullable": true
                          }
                        },
                        {
                          "type": "array",
                          "items": {
                            "nullable": true
                          }
                        },
                        {
                          "nullable": true
                        }
                      ]
                    },
                    "metadata": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "nullable": true
                        },
                        {
                          "type": "object",
                          "additionalProperties": {
                            "nullable": true
                          }
                        },
                        {
                          "type": "array",
                          "items": {
                            "nullable": true
                          }
                        },
                        {
                          "nullable": true
                        }
                      ]
                    },
                    "coordinates": {
                      "type": "object",
                      "nullable": true,
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ]
                    },
                    "created_at": {
                      "type": "string"
                    },
                    "updated_at": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "data",
                    "metadata",
                    "coordinates",
                    "created_at",
                    "updated_at"
                  ]
                }
              }
            }
