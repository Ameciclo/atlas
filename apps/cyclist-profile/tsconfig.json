{
	"extends": "@atlas/typescript-config/node-service.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": ".",
		"verbatimModuleSyntax": true,
		"jsxImportSource": "hono/jsx",
		"types": ["node", "vitest/globals"],
		"jsx": "react-jsx",
		"incremental": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "test/**/*"]
}
