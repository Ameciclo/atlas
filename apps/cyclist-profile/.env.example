# Node Environment
# Options: development, production, test
NODE_ENV=development

# Logging Level
# Options: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Server Configuration
# Port for the HTTP server
PORT=3000

# Database Configuration
# Full connection string for the database (used by the application)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyclist_profile_db

# Individual Database Credentials (used by Drizzle Kit for migrations)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cyclist_profile_db

