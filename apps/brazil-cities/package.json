{
	"name": "@atlas/brazil-cities",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc && pnpm generate-openapi",
		"start": "node dist/index.js",
		"lint": "biome lint .",
		"format": "biome format .",
		"check-types": "tsc --noEmit --project tsconfig.test.json",
		"test": "NODE_ENV=test vitest --run",
		"test:watch": "NODE_ENV=test vitest --watch",
		"generate-openapi": "tsx src/generate-openapi.ts",
		"pre-dev": "pnpm generate-openapi",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx src/db/seed.ts",
		"db:migrate:js": "node dist/db/migrate.js"
	},
	"dependencies": {
		"@hono/node-server": "^1.14.1",
		"@hono/zod-openapi": "^0.19.6",
		"dotenv": "^16.5.0",
		"hono": "^4.7.7",
		"hono-pino": "^0.8.0",
		"pino": "^9.6.0",
		"pino-pretty": "^13.0.0",
		"stoker": "^1.4.2",
		"zod": "^3.24.4",
		"drizzle-orm": "^0.43.1",
		"drizzle-zod": "^0.7.1",
		"pg": "^8.14.1"
	},
	"devDependencies": {
		"@types/node": "^22.15.17",
		"tsx": "^4.19.3",
		"typescript": "^5.8.3",
		"vitest": "^3.1.3",
		"@types/pg": "^8.11.13",
		"drizzle-kit": "^0.31.0"
	}
}
