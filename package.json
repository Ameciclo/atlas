{
	"name": "atlas",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"docker-dev": "pnpm --filter @atlas/docker-dev",
		"lint": "biome lint",
		"format": "biome format",
		"check": "biome check",
		"biome:ci": "biome ci",
		"check-types": "turbo run check-types",
		"test": "turbo run test",
		"generate-openapi": "turbo run generate-openapi && pnpm --filter @atlas/docs prepare-openapi",
		"openapi:validate": "node scripts/validate-openapi.js",
		"create-atlas-app": "pnpm --filter @atlas/create-atlas-app build && node packages/create-atlas-app/dist/index.js",
		"db:migrate": "pnpm --filter @atlas/database db:migrate",
		"db:seed": "pnpm --filter @atlas/database db:seed",
		"db:reset": "pnpm --filter @atlas/database db:reset",
		"db:reset:seed": "pnpm --filter @atlas/database db:reset:seed",
		"db:studio": "pnpm --filter @atlas/database db:studio",
		"db:generate": "pnpm --filter @atlas/database db:generate",
		"build:affected": "turbo run build --filter='...[HEAD^1]'",
		"test:affected": "turbo run test --filter='...[HEAD^1]'",
		"lint:affected": "turbo run lint --filter='...[HEAD^1]'",
		"deploy:staging": "./scripts/deploy.sh",
		"deploy:production": "./scripts/deploy.sh",
		"turbo:clean": "turbo run clean",
		"turbo:graph": "turbo run build --graph",
		"turbo:summary": "turbo run build --summarize"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.7",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.2",
		"turbo": "^2.5.8",
		"typescript": "5.9.3"
	},
	"packageManager": "pnpm@10.10.0",
	"engines": {
		"node": ">=18"
	},
	"dependencies": {
		"chalk": "^5.6.2",
		"drizzle-seed": "^0.3.1"
	}
}
